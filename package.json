{
  "name": "pactum-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Pactum Trust Layer Monorepo",
  "workspaces": [
    "backend",
    "frontend",
    "sdk/js",
    "packages/cli",
    "evm",
    "zk"
  ],
  "scripts": {
    "lint": "eslint \"**/*.{ts,tsx,js,jsx}\" --ignore-path .eslintignore",
    "lint:fix": "eslint \"**/*.{ts,tsx,js,jsx}\" --fix --ignore-path .eslintignore",
    "format": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:fix": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "check:ids": "node scripts/ci/check-numeric-ids.mjs",
    "test:ids": "node scripts/ci/check-numeric-ids.test.mjs",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.57.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.2.0",
    "prettier": "^3.2.5",
    "typescript": "^5.4.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "lodash": "^4.18.1"
  }
}
