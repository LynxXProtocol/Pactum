# Backend REST API this app reads from. See src/lib/api.ts.
VITE_API_URL=http://localhost:4000

# Module Federation remote entry URLs (see vite.config.ts and ../docs/module-federation.md).
# Point these at the deployed dashboard/wizard remotes' remoteEntry.js for a given environment.
# Unset, they default to this repo's local dev ports.
VITE_DASHBOARD_REMOTE_URL=http://localhost:5174/remoteEntry.js
VITE_WIZARD_REMOTE_URL=http://localhost:5175/remoteEntry.js
