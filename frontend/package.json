    "buffer": "^6.0.3",
    "clsx": "^2.1.1",
    "idb": "^8.0.3",
    "lib0": "^0.2.117",
    "lucide-react": "^1.32.0",
    "motion": "^13.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
