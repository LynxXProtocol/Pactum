{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite",
    "build:wasm": "node -e \"const fs=require('fs'); const p='../contracts/validation/Cargo.toml'; fs.writeFileSync(p, fs.readFileSync(p,'utf8').replace('crate-type = [\\\"rlib\\\"]', 'crate-type = [\\\"cdylib\\\", \\\"rlib\\\"]'));\" && npx wasm-pack build ../contracts/validation --target web --out-dir ../../frontend/src/wasm/pactum-validation -- --features wasm && node -e \"const fs=require('fs'); const p='../contracts/validation/Cargo.toml'; fs.writeFileSync(p, fs.readFileSync(p,'utf8').replace('crate-type = [\\\"cdylib\\\", \\\"rlib\\\"]', 'crate-type = [\\\"rlib\\\"]'));\"",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "preview": "vite preview",
    "test:unit": "node --test \"tests/unit/*.test.ts\"",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
