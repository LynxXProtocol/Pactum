{
  "name": "pactum-backend",
  "version": "1.0.0",
  "description": "Backend API and Indexer for Pactum Trust Layer",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "nodemon src/index.ts",
    "build": "tsc && npm run copy:migrations",
    "copy:migrations": "node -e \"require('fs').cpSync('src/db/migrations','dist/db/migrations',{recursive:true})\"",
    "pretest": "node ../scripts/ci/check-numeric-ids.mjs",
    "check:migrations": "node ../scripts/ci/check-numeric-ids.mjs --migrations-only",
    "test": "npm run test:indexer && npm run test:relayer && npm run test:crypto && npm run test:attestor",
    "test:indexer": "tsc -p tsconfig.indexer-test.json && find dist-indexer-test/src -type f -name '*.test.js' -exec node --test {} +",
    "test:relayer": "tsc -p tsconfig.relayer-test.json && node --test dist-relayer-test/tests/relayer.test.js",
    "test:crypto": "tsc -p tsconfig.crypto-test.json && find dist-crypto-test/src/crypto -type f -name '*.test.js' -exec node --test {} +",
    "test:attestor": "tsc -p tsconfig.attestor-test.json && find dist-attestor-test/tests -type f -name '*.test.js' -exec node --test {} +",
    "test:integration": "tsc -p tsconfig.integration-test.json && find dist-integration-test/tests/integration -type f -name '*.test.js' -exec node --test {} +",
    "load:reputation": "node scripts/load-reputation.js",
    "indexer": "node dist/workers/indexer.js",
    "bot": "node dist/workers/discordBot.js",
    "pactum-bot": "node dist/workers/discordBot.js",
    "dev:bot": "nodemon src/workers/discordBot.ts",
    "analytics:worker": "node dist/workers/analyticsWorker.js",
    "migrate:timescale": "node dist/db/migrate.js",
    "migrate:up": "npm run build && node dist/db/migrate.js",
    "migrate:make": "node scripts/migrate-make.js",
    "migrate:status": "npm run build && node dist/db/migrate-status.js",
    "migrate:dry-run": "npm run build && node dist/db/migrate-dry-run.js",
    "backfill:commitments": "node dist/indexer/backfill-commitments.js"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@stellar/stellar-sdk": "^16.2.0",
    "cors": "^2.8.6",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "ethers": "^6.13.0",
    "express": "^5.2.1",
    "ioredis": "^5.11.1",
    "jose": "^5.2.2",
    "json2csv": "6.0.0-alpha.2",
    "node-cron": "^4.6.0",
    "pdfkit": "0.15.2",
    "pg": "^8.23.0",
    "prom-client": "^15.1.3",
    "redis": "^6.2.1",
    "ws": "^8.21.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.1.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/pdfkit": "0.13.9",
    "@types/pg": "^8.21.0",
    "@types/redis": "^4.0.10",
    "@types/ws": "^8.18.1",
    "autocannon": "^8.0.0",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "lodash": "^4.18.1"
  }
}
