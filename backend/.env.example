# Horizon SSE Configuration (real-time event streaming)
HORIZON_URL=https://horizon-testnet.stellar.org
# Horizon SSE stream name used as the cursor persistence key in PostgreSQL
HORIZON_SSE_STREAM_NAME=pactum_events
# Reconnect back-off settings (milliseconds)
HORIZON_SSE_INITIAL_RECONNECT_MS=1000
HORIZON_SSE_MAX_RECONNECT_MS=30000

# Soroban RPC Configuration
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org:443
SOROBAN_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
SOROBAN_CONTRACT_ID=CBADTVTJ6IN332HIKZ7LWUYMYTLPZYCEBV3X2HS47VHR5UDBHQ3GAA7E

# Oracle Private Key (Server-side key for signing attestations)
# IMPORTANT: This should be a dedicated key with limited permissions
ORACLE_PRIVATE_KEY=SXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Oracle Worker Configuration
ORACLE_POLL_INTERVAL_MS=60000
ORACLE_MAX_RETRIES=3
ORACLE_RETRY_DELAY_MS=5000

# TimescaleDB Configuration (Time-series database for analytics)
TIMESCALEDB_HOST=localhost
TIMESCALEDB_PORT=5432
TIMESCALEDB_DATABASE=pactum_timeseries
TIMESCALEDB_USER=postgres
TIMESCALEDB_PASSWORD=postgres
# Set to 'true' if running on a managed Postgres host that does not support background workers
CAGG_MANUAL_REFRESH=false

# Analytics Worker Configuration
ANALYTICS_SNAPSHOT_INTERVAL_MS=3600000
MATERIALIZED_VIEW_REFRESH_INTERVAL_MS=300000

# Daily reputation snapshots. Set REPUTATION_SNAPSHOT_CRON=off to disable the job.
REPUTATION_SNAPSHOT_CRON=0 0 * * *
REPUTATION_SNAPSHOT_TIMEZONE=UTC
REPUTATION_SNAPSHOT_BATCH_SIZE=500

# ─── Soroban State Archival / TTL Monitor (Issue #58) ────────────────────────
#
# Stellar's Soroban ledger enforces state expiration: persistent entries whose
# TTL (time-to-live, in ledgers) drops to zero are archived and become
# unreadable until a RestoreFootprint transaction is submitted.  The TTL
# monitor proactively bumps the rent of high-value reputation entries so they
# never reach the archive threshold.
#
# TTL_MONITOR_CRON            – node-cron schedule for the scan.
#                               Default: every 6 hours.
# TTL_MONITOR_TIMEZONE        – Timezone for the cron schedule.
#                               Default: UTC.
# TTL_MONITOR_THRESHOLD_LEDGERS – TTL in ledgers below which a bump is submitted.
#                               Must be ≤ the contract's TTL_EXTEND_LEDGERS
#                               (518,400 ≈ 30 days).  Default matches the
#                               contract's TTL_THRESHOLD_LEDGERS (241,920 ≈ 14
#                               days) so entries are refreshed before they hit
#                               the expiration window.
# TTL_MONITOR_BUMP_CONCURRENCY – Max concurrent RestoreReputation transactions
#                               per monitor run.  Default: 5.
TTL_MONITOR_CRON=0 */6 * * *
TTL_MONITOR_TIMEZONE=UTC
TTL_MONITOR_THRESHOLD_LEDGERS=241920
TTL_MONITOR_BUMP_CONCURRENCY=5

# Soroban RPC event listener (indexer). Polls the deployed contract's events,
# parses them by symbol, and writes them to Timescale so reputation reads never
# hit the RPC live. Set INDEXER_ENABLED=off to disable the polling loop.
INDEXER_ENABLED=on
INDEXER_POLL_INTERVAL_MS=15000
INDEXER_FINALITY_DEPTH=0
# Optionally start indexing from a specific ledger instead of genesis:
# INDEXER_START_SEQUENCE=1

# Redis cache for reputation reads. Optional: leave REDIS_URL unset and the API
# serves every request straight from PostgreSQL.
REDIS_URL=redis://localhost:6379
REDIS_CONNECT_TIMEOUT_MS=2000
REPUTATION_CACHE_TTL_SECONDS=60

# Optional: External API Keys for monitoring services
# PINGDOM_API_KEY=your_pingdom_api_key
# UPTIMEROBOT_API_KEY=your_uptimerobot_api_key

# ─── Pactum Discord & Slack Bot Worker Configuration ──────────────────────────
# Discord Bot Token and Channel ID for gateway bot delivery (via discord.js)
# DISCORD_BOT_TOKEN=your_discord_bot_token_here
# DISCORD_CHANNEL_ID=123456789012345678

# Discord Incoming Webhook URL (alternative to full bot token)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/.../...

# Slack Incoming Webhook URL
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/.../.../...

# Bot Polling Configuration
# BOT_POLL_INTERVAL_MS=5000
# Optional: Set starting ISO timestamp or cursor for bot event polling
# BOT_START_TIME=2026-01-01T00:00:00.000Z

